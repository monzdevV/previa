# Claves y configuracion local (nunca al repositorio).
#
# El orden importa: en git gana el ultimo patron que coincide, asi que la
# excepcion de la plantilla tiene que ir DESPUES de los patrones que la
# taparian. Ordenar este fichero alfabeticamente lo rompe.
.env
.env.*
!.env.example
lib/core/supabase_config.dart

# Flutter, Dart y Pub
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
/build/
/coverage/
app.*.map.json
app.*.symbols
migrate_working_dir/
**/doc/api/

# Android Studio deja aqui sus artefactos
/android/app/debug
/android/app/profile
/android/app/release
**/ios/Flutter/.last_build_id

# Simbolizacion y ofuscacion
*.class
*.log

# Editores
.idea/
*.iml
*.ipr
*.iws
.atom/
.history
.swiftpm/
# La carpeta .vscode lleva configuracion de lanzamiento que puede interesar
# versionar, asi que se deja fuera de la lista a proposito.
#.vscode/

# Vista previa de widgets
.widget_preview/

# Sistema operativo
.DS_Store
desktop.ini
.build/
.buildlog/
.svn/
*.pyc
*.swp
*.tmp

# Capturas que genera un golden al fallar. Son de diagnostico, no fuente.
test/failures/
